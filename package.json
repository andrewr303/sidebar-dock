{
  "name": "still-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A calm, local-first Chrome sidebar for bookmarks, notes, highlights and files.",
  "bin": {
    "still-mcp": "bridge/mcp.mjs",
    "still-bridge": "bridge/server.mjs",
    "still-connect": "bridge/setup.mjs",
    "still-auth-header": "bridge/auth-header.mjs"
  },
  "files": [
    "bridge/",
    "!bridge/.local/",
    "extension/lib/pages.js",
    "extension/lib/ai-prompts.js",
    "extension/lib/ai/permissions.js",
    "agent-skills/",
    ".claude-plugin/",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "layer:build": "npm --prefix browser-control run build",
    "layer:check": "npm --prefix browser-control run check",
    "layer:test": "npm --prefix browser-control test",
    "e2e": "node scripts/e2e-browser.mjs",
    "bridge": "node bridge/server.mjs",
    "connect": "node bridge/setup.mjs",
    "mcp": "node bridge/mcp.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
