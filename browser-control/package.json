  "dependencies": {
    "puppeteer-core": "25.16.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
